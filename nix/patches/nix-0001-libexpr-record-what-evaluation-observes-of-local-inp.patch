+nix_err nix_eval_state_input_observations(
+    nix_c_context * context, EvalState * state, nix_input_observation_callback callback, void * user_data)
+{
+    if (context)
+        context->last_err_code = NIX_OK;
+    try {
+        if (!state->state.inputObservations)
+            return NIX_OK;
+        for (auto & o : state->state.inputObservations->get())
+            callback(
+                user_data,
+                std::string(nix::fetchers::observationKindName(o.kind)).c_str(),
+                o.input.c_str(),
+                o.path.c_str(),
+                o.value.c_str());
+    }
+    NIXC_CATCH_ERRS
+}
