+ * A working directory as getAccessorFromWorkdir() shows it, without the
+ * status: visible are the files in the index that the status would not
+ * report deleted, and the directories holding them. Only the entries that
+ * decide a path looked at are stat'd.
+ */
+struct WorkdirIndexAccessor : FilteringSourceAccessor
+{
+    std::filesystem::path repoPath;
+    std::set<CanonPath> index;
+    std::mutex mutex;
+    std::map<CanonPath, bool> present;
+
+    void anchor() override {};
+
+    WorkdirIndexAccessor(std::filesystem::path repoPath_, std::set<CanonPath> index, MakeNotAllowedError && error)
+        : FilteringSourceAccessor(
+              SourcePath(makeFSSourceAccessor(repoPath_, /*trackLastModified=*/false, FinalSymlink::Follow)),
+              std::move(error))
+        , repoPath(std::move(repoPath_))
+        , index(std::move(index))
+    {
+    }
+
+    /* Git reports a file replaced by a directory as deleted too. */
+    bool isPresent(const CanonPath & file)
+    {
+        std::lock_guard lock(mutex);
+        auto [i, inserted] = present.try_emplace(file, false);
+        if (inserted) {
+            auto st = nix::maybeLstat(repoPath / file.rel());
+            i->second = st && !S_ISDIR(st->st_mode);
+        }
+        return i->second;
+    }
+
+    /* As CanonPath::isAllowed() with the files of the status. */
+    bool isAllowed(const CanonPath & path) override
+    {
+        if (path.isRoot())
+            return true;
+        for (auto i = index.lower_bound(path); i != index.end() && i->isWithin(path); ++i)
+            if (isPresent(*i))
+                return true;
+        auto parent = path;
+        while (!parent.isRoot()) {
+            parent.pop();
+            if (index.count(parent) && isPresent(parent))
+                return true;
+        }
+        return false;
+    }
+};
