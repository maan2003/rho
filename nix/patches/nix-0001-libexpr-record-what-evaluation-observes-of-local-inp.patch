 namespace nix {
 
+namespace {
+
+/**
+ * Records every read of a mounted local input, with what the read observed:
+ * the empty string if it failed. See `record-input-reads`.
+ */
+class RecordingSourceAccessor : public SourceAccessor
+{
+    ref<SourceAccessor> next;
+    ref<fetchers::InputObservations> observations;
+    std::string input;
+
+    void anchor() override {};
+
+    void record(fetchers::ObservationKind kind, const CanonPath & path, std::string value)
+    {
+        observations->record({kind, input, std::string(path.rel()), std::move(value)});
+    }
+
+public:
+    RecordingSourceAccessor(ref<SourceAccessor> next_, ref<fetchers::InputObservations> observations, std::string input)
+        : next(std::move(next_))
+        , observations(std::move(observations))
+        , input(std::move(input))
+    {
+        displayPrefix.clear();
+    }
+
+    void readFile(const CanonPath & path, Sink & sink, fun<void(uint64_t)> sizeCallback) override
+    {
+        fetchers::ContentsObserver contents;
+        TeeSink tee(sink, contents.sink);
+        try {
+            next->readFile(path, tee, sizeCallback);
+        } catch (Error &) {
+            record(fetchers::ObservationKind::File, path, "");
+            throw;
+        }
+        record(fetchers::ObservationKind::File, path, contents.finish());
+    }
+
+    std::optional<Stat> maybeLstat(const CanonPath & path) override
+    {
+        std::optional<Stat> st;
+        try {
+            st = next->maybeLstat(path);
+        } catch (Error &) {
+            record(fetchers::ObservationKind::Stat, path, "");
+            throw;
+        }
+        record(fetchers::ObservationKind::Stat, path, fetchers::observeStat(st));
+        return st;
+    }
+
+    DirEntries readDirectory(const CanonPath & path) override
+    {
+        DirEntries entries;
+        try {
+            entries = next->readDirectory(path);
+        } catch (Error &) {
+            record(fetchers::ObservationKind::Dir, path, "");
+            throw;
+        }
+        record(fetchers::ObservationKind::Dir, path, fetchers::observeListing(entries));
+        return entries;
+    }
+
+    std::string readLink(const CanonPath & path) override
+    {
+        std::string target;
+        try {
+            target = next->readLink(path);
+        } catch (Error &) {
+            record(fetchers::ObservationKind::Link, path, "");
+            throw;
+        }
+        record(fetchers::ObservationKind::Link, path, target);
+        return target;
+    }
+
+    std::string showPath(const CanonPath & path) override
+    {
+        return next->showPath(path);
+    }
+
+    void invalidateCache() override
+    {
+        next->invalidateCache();
+    }
+
+    /* Hide the physical path and fingerprint so that nothing reads the input
+       behind our back, whether from disk or from the fetcher cache. */
+    std::optional<std::filesystem::path> getPhysicalPath(const CanonPath & path) override
+    {
+        return std::nullopt;
+    }
+
+    std::pair<CanonPath, std::optional<std::string>> getFingerprint(const CanonPath & path) override
+    {
+        return {path, std::nullopt};
+    }
+
+    std::optional<time_t> getLastModified() override
+    {
+        return next->getLastModified();
+    }
+};
+
