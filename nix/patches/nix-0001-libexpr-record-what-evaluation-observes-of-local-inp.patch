+/**
+ * Adapter carrying a source-info metadata attribute whose value is recorded
+ * as an observation of its input when forced (see `record-input-reads`).
+ */
+class ObservedInputAttr : public ExternalValueBase, public gc_cleanup
+{
+private:
+    /* VTable anchor, see LazyFetcherAttr. */
+    virtual void anchor();
+
+public:
+    std::string storePath;
+    std::string name;
+    Value * inner;
+
+    ObservedInputAttr(std::string storePath, std::string name, Value * inner)
+        : storePath(std::move(storePath))
+        , name(std::move(name))
+        , inner(inner)
+    {
+    }
+
+protected:
+    std::ostream & print(std::ostream & str) const override
+    {
+        unreachable();
+    }
+
+public:
+    std::string showType() const override
+    {
+        unreachable();
+    }
+
+    std::string typeOf() const override
+    {
+        unreachable();
+    }
+};
+
+void ObservedInputAttr::anchor() {}
+
+/**
+ * internal primop: Force and record an ObservedInputAttr external value.
+ */
+static void prim_forceObservedInputAttr(EvalState & state, const PosIdx pos, Value ** args, Value & v)
+{
+    Value & arg = *args[0];
+
+    state.forceValue(arg, pos);
+    assert(arg.type() == nExternal);
+    auto * ext = dynamic_cast<ObservedInputAttr *>(args[0]->external());
+    assert(ext);
+
+    state.forceValue(*ext->inner, pos);
+    v = *ext->inner;
+    if (state.inputObservations)
+        if (auto input = state.inputObservations->inputAt(ext->storePath))
+            state.inputObservations->record({
+                .kind = fetchers::ObservationKind::Attr,
+                .input = *input,
+                .path = ext->name,
+                .value = v.type() == nInt ? std::to_string(v.integer().value) : std::string(v.string_view()),
+            });
+}
+
+/**
+ * Allocate `name` in `attrs` as a thunk that records its value as an
+ * observation when forced, and return the value the caller should initialize
+ * instead. This lets eval caches treat metadata such as `self.rev` as an
+ * input only when the evaluation actually depends on it. Keep in sync with
+ * `fetchers::observeSourceInfoAttr`.
+ */
+static Value & observedInputAttr(
+    EvalState & state, BindingsBuilder & attrs, const StorePath & storePath, std::string_view name)
+{
+    // not user-callable (unregistered, internal)
+    static PrimOp forcePrimOp{
+        .name = "__forceObservedInputAttr",
+        .arity = 1,
+        .impl = prim_forceObservedInputAttr,
+        .internal = true,
+    };
+
+    auto * inner = state.allocValue();
+
+    auto * vExt = state.allocValue();
+    vExt->mkExternal(new ObservedInputAttr(state.store->printStorePath(storePath), std::string(name), inner));
+
+    auto * vPrimOp = state.allocValue();
+    vPrimOp->mkPrimOp(&forcePrimOp);
+
+    attrs.alloc(name).mkApp(vPrimOp, vExt);
+    return *inner;
+}
