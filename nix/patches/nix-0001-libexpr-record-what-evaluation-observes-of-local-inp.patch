diff --git a/src/libfetchers/input-observations.cc b/src/libfetchers/input-observations.cc
new file mode 100644
index 000000000..8a6de758e
--- /dev/null
+++ b/src/libfetchers/input-observations.cc
@@ -0,0 +1,183 @@
+#include "nix/fetchers/input-observations.hh"
+#include "nix/fetchers/attrs.hh"
+#include "nix/util/hash.hh"
+
+#include <iomanip>
+
+namespace nix::fetchers {
+
+namespace {
+
+/* Observations are hashed with BLAKE3 whether or not users may. */
+const ExperimentalFeatureSettings & observationXpSettings()
+{
+    static const ExperimentalFeatureSettings & settings = *[] {
+        auto settings = new ExperimentalFeatureSettings;
+        settings->set("experimental-features", "blake3-hashes");
+        return settings;
+    }();
+    return settings;
+}
+
+} // namespace
+
+ref<SourceAccessor> Input::getLocalAccessor(const Settings & settings, Store & store) const
+{
+    if (!scheme)
+        throw Error("cannot fetch unsupported input '%s'", to_string());
+    return scheme->getLocalAccessor(settings, store, *this);
+}
+
+Input Input::getLocalSourceInfo(const Settings & settings, Store & store) const
+{
+    if (!scheme)
+        throw Error("cannot fetch unsupported input '%s'", to_string());
+    return scheme->getLocalSourceInfo(settings, store, *this);
+}
+
+std::string_view observationKindName(ObservationKind kind)
+{
+    switch (kind) {
+    case ObservationKind::Stat:
+        return "stat";
+    case ObservationKind::File:
+        return "file";
+    case ObservationKind::Dir:
+        return "dir";
+    case ObservationKind::Link:
+        return "link";
+    case ObservationKind::Attr:
+        return "attr";
+    }
+    unreachable();
+}
+
+std::optional<ObservationKind> parseObservationKind(std::string_view name)
+{
+    for (auto kind :
+         {ObservationKind::Stat, ObservationKind::File, ObservationKind::Dir, ObservationKind::Link, ObservationKind::Attr})
+        if (observationKindName(kind) == name)
+            return kind;
+    return std::nullopt;
+}
+
+std::string observeStat(const std::optional<SourceAccessor::Stat> & st)
+{
+    return !st                                  ? "missing"
+           : st->type == SourceAccessor::tRegular   ? (st->isExecutable ? "executable" : "regular")
+           : st->type == SourceAccessor::tDirectory ? "directory"
+           : st->type == SourceAccessor::tSymlink   ? "symlink"
+                                                    : "other";
+}
+
+std::string observeListing(const SourceAccessor::DirEntries & entries)
+{
+    std::string names;
+    for (auto & [name, _] : entries) {
+        names += name;
+        names += '\0';
+    }
+    return hashString(HashAlgorithm::BLAKE3, names, observationXpSettings()).to_string(HashFormat::Base16, false);
+}
+
+ContentsObserver::ContentsObserver()
+    : sink(HashAlgorithm::BLAKE3, observationXpSettings())
+{
+}
+
+std::string ContentsObserver::finish()
+{
+    return sink.finish().hash.to_string(HashFormat::Base16, false);
+}
+
+/* What evaluation reads of a path; throws if it could not read it. */
+static std::string observePath(SourceAccessor & accessor, ObservationKind kind, const CanonPath & path)
+{
+    switch (kind) {
+    case ObservationKind::Stat:
+        return observeStat(accessor.maybeLstat(path));
+    case ObservationKind::File: {
+        ContentsObserver contents;
+        accessor.readFile(path, contents.sink);
+        return contents.finish();
+    }
+    case ObservationKind::Dir:
+        return observeListing(accessor.readDirectory(path));
+    case ObservationKind::Link:
+        return accessor.readLink(path);
+    case ObservationKind::Attr:
+        break;
+    }
+    unreachable();
+}
+
+std::string observe(SourceAccessor & accessor, const Input & input, ObservationKind kind, const CanonPath & path)
+{
+    if (kind == ObservationKind::Attr)
+        return observeSourceInfoAttr(input, path.rel()).value_or("");
+    try {
+        return observePath(accessor, kind, path);
+    } catch (Error &) {
+        return "";
+    }
+}
+
+/* Keep in sync with emitTreeAttrs, for inputs of flakes (no empty-rev
+   fallback, not forced dirty). */
+std::optional<std::string> observeSourceInfoAttr(const Input & input, std::string_view name)
+{
+    if (name == "rev" || name == "shortRev") {
+        auto rev = input.getRev();
+        if (!rev)
+            return std::nullopt;
+        return name == "rev" ? rev->gitRev() : rev->gitShortRev();
+    }
+    if (name == "revCount") {
+        if (auto lazy = maybeGetLazyAttr(input.attrs, "revCount"))
+            return std::to_string(std::get<uint64_t>(forceAttr(*lazy)));
+        if (auto revCount = input.getRevCount())
+            return std::to_string(*revCount);
+        return std::nullopt;
+    }
+    if (name == "dirtyRev" || name == "dirtyShortRev")
+        return maybeGetStrAttr(input.attrs, std::string(name));
+    if (name == "lastModified" || name == "lastModifiedDate") {
+        auto lastModified = input.getLastModified();
+        if (!lastModified)
+            return std::nullopt;
+        if (name == "lastModified")
+            return std::to_string(*lastModified);
+        return fmt("%s", std::put_time(std::gmtime(&*lastModified), "%Y%m%d%H%M%S"));
+    }
+    return std::nullopt;
+}
+
+void InputObservations::record(InputObservation observation)
+{
+    std::lock_guard lock(mutex);
+    if (seen.insert(observation).second)
+        observations.push_back(std::move(observation));
+}
+
+std::vector<InputObservation> InputObservations::get()
+{
+    std::lock_guard lock(mutex);
+    return observations;
+}
+
+void InputObservations::mounted(std::string mountPoint, std::string input)
+{
+    std::lock_guard lock(mutex);
+    mounts.insert_or_assign(std::move(mountPoint), std::move(input));
+}
+
+std::optional<std::string> InputObservations::inputAt(const std::string & mountPoint)
+{
+    std::lock_guard lock(mutex);
+    auto i = mounts.find(mountPoint);
+    if (i == mounts.end())
+        return std::nullopt;
+    return i->second;
+}
+
+} // namespace nix::fetchers
