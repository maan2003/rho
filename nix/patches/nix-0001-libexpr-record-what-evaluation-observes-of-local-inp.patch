diff --git a/src/libfetchers/include/nix/fetchers/input-observations.hh b/src/libfetchers/include/nix/fetchers/input-observations.hh
new file mode 100644
index 000000000..589214809
--- /dev/null
+++ b/src/libfetchers/include/nix/fetchers/input-observations.hh
@@ -0,0 +1,104 @@
+#pragma once
+///@file
+
+#include "nix/util/source-accessor.hh"
+#include "nix/fetchers/fetchers.hh"
+
+#include <mutex>
+#include <set>
+
+namespace nix::fetchers {
+
+/**
+ * What an evaluation can observe of a local input: a path's type, a file's
+ * contents, a directory's entries, a symlink's target, or one of the
+ * input's source-info attributes (`rev`, `lastModified`, ...). Recorded with
+ * `record-input-reads`, a result can be revalidated by observing the same
+ * things again and comparing.
+ */
+enum class ObservationKind { Stat, File, Dir, Link, Attr };
+
+std::string_view observationKindName(ObservationKind kind);
+
+std::optional<ObservationKind> parseObservationKind(std::string_view name);
+
+/**
+ * How a stat is observed: `missing`, `regular`, `executable`, `directory`,
+ * `symlink` or `other`.
+ */
+std::string observeStat(const std::optional<SourceAccessor::Stat> & st);
+
+/**
+ * How a directory listing is observed: the base16 BLAKE3 of the entry
+ * names, each followed by a NUL byte, in sorted order.
+ */
+std::string observeListing(const SourceAccessor::DirEntries & entries);
+
+/**
+ * A sink computing how file contents written to it are observed: their
+ * base16 BLAKE3.
+ */
+struct ContentsObserver
+{
+    HashSink sink;
+    ContentsObserver();
+    std::string finish();
+};
+
+/**
+ * What evaluation would observe of `path` (for `Attr`, the attribute name)
+ * in `input` through `accessor`, its accessor now: the empty string for a
+ * read that fails, and for an attribute the input does not have.
+ */
+std::string observe(SourceAccessor & accessor, const Input & input, ObservationKind kind, const CanonPath & path);
+
+/**
+ * The source-info attribute `name` as evaluation shows it for `input`, if
+ * it has one.
+ */
+std::optional<std::string> observeSourceInfoAttr(const Input & input, std::string_view name);
+
+struct InputObservation
+{
+    ObservationKind kind;
+    /**
+     * The input as the evaluation named it, before locking.
+     */
+    std::string input;
+    /**
+     * Relative to the input's root, empty for the root itself; for `Attr`,
+     * the attribute name.
+     */
+    std::string path;
+    /**
+     * Empty if the read failed.
+     */
+    std::string value;
+
+    auto operator<=>(const InputObservation &) const = default;
+};
+
+/**
+ * What an evaluation observed of its local inputs. An observation repeated
+ * with the same value is kept once; one with a different value is kept
+ * again, so that a change during evaluation shows.
+ */
+class InputObservations
+{
+    std::mutex mutex;
+    std::set<InputObservation> seen;
+    std::vector<InputObservation> observations;
+    /* Mount point of each local input, to attribute its source info. */
+    std::map<std::string, std::string> mounts;
+
+public:
+    void record(InputObservation observation);
+
+    std::vector<InputObservation> get();
+
+    void mounted(std::string mountPoint, std::string input);
+
+    std::optional<std::string> inputAt(const std::string & mountPoint);
+};
+
+} // namespace nix::fetchers
