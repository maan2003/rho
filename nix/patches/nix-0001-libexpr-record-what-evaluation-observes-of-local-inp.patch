+    }
+    NIXC_CATCH_ERRS_NULL
+}
+
+nix_err nix_local_input_observe(
+    nix_c_context * context,
+    nix_local_input * input,
+    const char * kind,
+    const char * path,
+    nix_get_string_callback callback,
+    void * user_data)
+{
+    if (context)
+        context->last_err_code = NIX_OK;
+    try {
+        auto parsed = nix::fetchers::parseObservationKind(kind);
+        if (!parsed)
+            throw nix::Error("unknown observation kind '%s'", kind);
+        if (*parsed == nix::fetchers::ObservationKind::Attr && !input->sourceInfo)
+            input->sourceInfo = input->input.getLocalSourceInfo(*input->settings, *input->store);
+        auto observed = nix::fetchers::observe(
+            *input->accessor, input->sourceInfo.value_or(input->input), *parsed, nix::CanonPath(path));
+        return call_nix_get_string_callback(observed, callback, user_data);
+    }
+    NIXC_CATCH_ERRS
+}
+
+void nix_local_input_free(nix_local_input * input)
+{
+    delete input;
+}
+
 } // extern "C"
