+/**
+ * @brief Get a settings view for the builder's evaluator settings.
+ *
+ * The returned view targets the `EvalSettings` that the built EvalState will
+ * use. Use it with nix_abstract_settings_set() to override a setting such as
+ * "pure-eval" before calling nix_eval_state_build(). Call it after
+ * nix_eval_state_builder_load(), which would otherwise override the values set
+ * here. Free the view with nix_abstract_settings_free(); this does not free
+ * @p builder, which must outlive the view.
+ *
+ * @param[out] context Optional, stores error information
+ * @param[in] builder The builder whose evaluator settings to view
+ * @return A settings view, or NULL on error
+ */
+nix_abstract_settings *
+nix_eval_state_builder_eval_settings_as_abstract_settings(nix_c_context * context, nix_eval_state_builder * builder);
+
 /**
  * @brief Create a new Nix language evaluator state
  * @ingroup libexpr_init
