 src/libexpr/paths.cc                          | 135 +++++++++++++++++-
 src/libutil/hash.cc                           |   7 +-
 src/libutil/include/nix/util/hash.hh          |   3 +-
 7 files changed, 206 insertions(+), 5 deletions(-)

