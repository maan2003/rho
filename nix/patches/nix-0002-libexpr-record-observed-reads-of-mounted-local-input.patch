+    ObservedStat,
+    ObservedFile,
+    ObservedDir,
+    ObservedLink,
 };
 
 inline std::string_view evalEffectName(EvalEffect effect)
@@ -49,6 +53,14 @@ inline std::string_view evalEffectName(EvalEffect effect)
         return "mount-input";
     case EvalEffect::InputAttr:
         return "input-attr";
+    case EvalEffect::ObservedStat:
+        return "observed-stat";
+    case EvalEffect::ObservedFile:
+        return "observed-file";
+    case EvalEffect::ObservedDir:
+        return "observed-dir";
+    case EvalEffect::ObservedLink:
+        return "observed-link";
     }
     std::unreachable();
 }
@@ -67,6 +79,15 @@ inline std::string_view evalEffectName(EvalEffect effect)
  * destination store path), `mount-input` (subject is the virtual store path
  * an input is mounted at, detail is the input URL), and `input-attr`
  * (subject is the input URL, detail is the forced metadata attribute).
+ *
+ * With `record-input-reads`, reads of mounted local inputs report what was
+ * observed, with the subject being the path under the input's virtual store
+ * path: `observed-stat` (detail is `regular`, `executable`, `directory`,
+ * `symlink`, `other` or `missing`), `observed-file` (detail is the BLAKE3 of
+ * the contents in base16), `observed-dir` (detail is the BLAKE3 of the entry
+ * names, each followed by a NUL byte, in sorted order), and `observed-link`
+ * (detail is the symlink target). A path is reported again only if a later
+ * read observes something different.
  */
 inline void evalEffect(EvalEffect kind, std::string_view subject, std::optional<std::string_view> detail = std::nullopt)
 {
diff --git a/src/libexpr/include/nix/expr/eval-settings.hh b/src/libexpr/include/nix/expr/eval-settings.hh
index 4613017d7..90667d960 100644
--- a/src/libexpr/include/nix/expr/eval-settings.hh
+++ b/src/libexpr/include/nix/expr/eval-settings.hh
@@ -494,6 +494,21 @@ public:
           The default value is chosen to balance performance and memory usage. On 32 bit systems
           where memory is scarce, the default is a large value to reduce the amount of allocations.
     )"};
+
+    Setting<bool> recordInputReads{
+        this,
+        false,
+        "record-input-reads",
+        R"(
+          Report every read of a mounted local input as an eval effect carrying
+          what was observed: the BLAKE3 hash of file contents and directory
+          listings, the type of stat'd paths, and symlink targets.
+
+          This lets a caller decide whether an evaluation result is still valid
+          by comparing the file system against exactly what the evaluator read.
+          Reads bypass the fetcher cache, so copies of local inputs are always
+          walked.
+        )"};
 };
 
