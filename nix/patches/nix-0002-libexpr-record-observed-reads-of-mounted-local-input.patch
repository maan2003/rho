index bdc9fbeda..fc4d25258 100644
--- a/src/libexpr/eval-effect.hh
+++ b/src/libexpr/eval-effect.hh
@@ -22,6 +22,10 @@ enum class EvalEffect {
     CopySource,
     MountInput,
