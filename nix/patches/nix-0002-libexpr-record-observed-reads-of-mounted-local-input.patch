diff --git a/src/libexpr/paths.cc b/src/libexpr/paths.cc
index 8a623cf44..1be5698e3 100644
--- a/src/libexpr/paths.cc
+++ b/src/libexpr/paths.cc
@@ -3,9 +3,134 @@
 #include "eval-effect.hh"
 #include "nix/util/mounted-source-accessor.hh"
 #include "nix/fetchers/fetch-to-store.hh"
+#include "nix/util/hash.hh"
+
+#include <mutex>
+#include <unordered_map>
 
 namespace nix {
 
+namespace {
+
+/* Observations are hashed with BLAKE3 whether or not users may. */
+const ExperimentalFeatureSettings & observationXpSettings()
+{
+    static const ExperimentalFeatureSettings & settings = *[] {
+        auto settings = new ExperimentalFeatureSettings;
+        settings->set("experimental-features", "blake3-hashes");
+        return settings;
+    }();
+    return settings;
+}
+
+/**
+ * Reports every read of a mounted local input, with what the read observed,
+ * as an eval effect. See `record-input-reads`.
+ */
+class RecordingSourceAccessor : public SourceAccessor
+{
+    ref<SourceAccessor> next;
+    std::string mountPoint;
+
+    std::mutex mutex;
+    /* Last reported observation per (kind, subject). */
+    std::unordered_map<std::string, std::string> reported;
+
+    void anchor() override {};
+
+    void report(EvalEffect kind, const CanonPath & path, std::string detail)
+    {
+        auto subject = path.isRoot() ? mountPoint : mountPoint + path.abs();
+        {
+            std::lock_guard lock(mutex);
+            auto [it, inserted] = reported.try_emplace(std::string(evalEffectName(kind)) + '\0' + subject, detail);
+            if (!inserted) {
+                if (it->second == detail)
+                    return;
+                it->second = detail;
+            }
+        }
+        evalEffect(kind, subject, detail);
+    }
+
+public:
+    RecordingSourceAccessor(ref<SourceAccessor> next_, std::string mountPoint)
+        : next(std::move(next_))
+        , mountPoint(std::move(mountPoint))
+    {
+        displayPrefix.clear();
+    }
+
+    void readFile(const CanonPath & path, Sink & sink, fun<void(uint64_t)> sizeCallback) override
+    {
+        HashSink hashSink(HashAlgorithm::BLAKE3, observationXpSettings());
+        TeeSink tee(sink, hashSink);
+        next->readFile(path, tee, sizeCallback);
+        report(EvalEffect::ObservedFile, path, hashSink.finish().hash.to_string(HashFormat::Base16, false));
+    }
+
+    std::optional<Stat> maybeLstat(const CanonPath & path) override
+    {
+        auto st = next->maybeLstat(path);
+        std::string type = !st                           ? "missing"
+                           : st->type == tRegular        ? (st->isExecutable ? "executable" : "regular")
+                           : st->type == tDirectory      ? "directory"
+                           : st->type == tSymlink        ? "symlink"
+                                                         : "other";
+        report(EvalEffect::ObservedStat, path, std::move(type));
+        return st;
+    }
+
+    DirEntries readDirectory(const CanonPath & path) override
+    {
+        auto entries = next->readDirectory(path);
+        std::string names;
+        for (auto & [name, _] : entries) {
+            names += name;
+            names += '\0';
+        }
+        report(
+            EvalEffect::ObservedDir, path, hashString(HashAlgorithm::BLAKE3, names, observationXpSettings()).to_string(HashFormat::Base16, false));
+        return entries;
+    }
+
+    std::string readLink(const CanonPath & path) override
+    {
+        auto target = next->readLink(path);
+        report(EvalEffect::ObservedLink, path, target);
+        return target;
+    }
+
+    std::string showPath(const CanonPath & path) override
+    {
+        return next->showPath(path);
+    }
+
+    void invalidateCache() override
+    {
+        next->invalidateCache();
+    }
+
+    /* Hide the physical path and fingerprint so that nothing reads the input
+       behind our back, whether from disk or from the fetcher cache. */
+    std::optional<std::filesystem::path> getPhysicalPath(const CanonPath & path) override
+    {
+        return std::nullopt;
+    }
+
+    std::pair<CanonPath, std::optional<std::string>> getFingerprint(const CanonPath & path) override
+    {
+        return {path, std::nullopt};
+    }
+
+    std::optional<time_t> getLastModified() override
+    {
+        return next->getLastModified();
+    }
+};
+
+} // namespace
+
 SourcePath EvalState::rootPath(CanonPath path)
 {
     return {rootFS, std::move(path)};
@@ -75,7 +200,15 @@ EvalState::mountInput(fetchers::Input & input, const fetchers::Input & originalI
 
     allowPath(storePath); // FIXME: should just whitelist the entire virtual store
 
-    storeFS->mount(CanonPath(store->printStorePath(storePath)), accessor);
+    auto mountPoint = store->printStorePath(storePath);
+    if (settings.recordInputReads) {
+        /* Inputs in the store are immutable and identified by their lock. */
+        auto sourcePath = input.getSourcePath(fetchSettings);
+        if (sourcePath && !store->isInStore(sourcePath->string()))
+            accessor = make_ref<RecordingSourceAccessor>(accessor, mountPoint);
+    }
+
+    storeFS->mount(CanonPath(mountPoint), accessor);
 
     evalEffect(EvalEffect::MountInput, store->printStorePath(storePath), originalInput.to_string());
 
