index 7e7f0ad47..45b3aa3da 100644
--- a/src/libexpr-c/nix_api_expr.h
+++ b/src/libexpr-c/nix_api_expr.h
@@ -278,6 +278,23 @@ nix_err nix_eval_state_builder_set_env_override(
