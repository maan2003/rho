+/**
+ * @brief Bash applying a BuildEnvironment to an interactive shell, as
+ * `nix develop` does.
+ *
+ * Unlike nix_build_env_to_bash(), this leaves the variables an interactive
+ * shell keeps alone, keeps the shell's `PATH` and `XDG_DATA_DIRS` after the
+ * environment's, makes fresh temporary directories, and runs `shellHook`.
+ *
+ * @param[out] context Optional, stores error information
+ * @param[in] env The environment
+ * @param[in] tmp_dir Where structured attributes files are written; it must
+ * outlive uses of the script
+ * @param[in] outputs_dir The directory the environment's outputs are
+ * redirected to
+ * @param[in] callback Called with the script
+ * @param[in] user_data Optional, arbitrary data passed to the callback
+ * @return NIX_OK on success, an error code otherwise
+ */
+nix_err nix_build_env_to_rc_script(
+    nix_c_context * context,
+    nix_build_env * env,
+    const char * tmp_dir,
+    const char * outputs_dir,
+    nix_get_string_callback callback,
+    void * user_data);
+
 /**
  * @brief Check if the environment provides structured attributes.
  *
diff --git a/src/libstore/build-environment.cc b/src/libstore/build-environment.cc
index 9c3c17f20..1616b5e44 100644
--- a/src/libstore/build-environment.cc
+++ b/src/libstore/build-environment.cc
@@ -282,4 +282,109 @@ std::pair<StorePath, BuildEnvironment> BuildEnvironment::getDevEnvironment(ref<S
     throw Error("get-env.sh failed to produce an environment");
 }
 
+const StringSet BuildEnvironment::interactiveIgnoreVars{
+    "BASHOPTS",
+    "HOME", // FIXME: don't ignore in pure mode?
+    "NIX_BUILD_TOP",
+    "NIX_ENFORCE_PURITY",
+    "NIX_LOG_FD",
+    "NIX_REMOTE",
+    "PPID",
+    "SHELLOPTS",
+    "SSL_CERT_FILE", // FIXME: only want to ignore /no-cert-file.crt
+    "TEMP",
+    "TEMPDIR",
+    "TERM",
+    "TMP",
+    "TMPDIR",
+    "TZ",
+    "UID",
+};
+
+/**
+ * Replace the value of NIX_ATTRS_*_FILE (`/build/.attrs.*`) with a tmp file
+ * that's accessible from the interactive shell session.
+ */
+static void fixupStructuredAttrs(
+    PathView::string_view ext,
+    const std::string & envVar,
+    const std::string & content,
+    StringMap & rewrites,
+    const BuildEnvironment & buildEnvironment,
+    const std::filesystem::path & tmpDir)
+{
+    auto targetFilePath = tmpDir / OS_STR(".attrs.");
+    targetFilePath += ext;
+
+    writeFile(targetFilePath, content);
+
+    auto fileInBuilderEnv = buildEnvironment.vars.find(envVar);
+    assert(fileInBuilderEnv != buildEnvironment.vars.end());
+    rewrites.insert({BuildEnvironment::getString(fileInBuilderEnv->second), targetFilePath.string()});
+}
+
+std::string BuildEnvironment::toRcScript(
+    const std::filesystem::path & tmpDir, const std::filesystem::path & outputsDir, StringMap extraRewrites) const
+{
+    // A list of colon-separated environment variables that should be
+    // prepended to, rather than overwritten, in order to keep the shell usable.
+    // Please keep this list minimal in order to avoid impurities.
+    static const char * const savedVars[] = {
+        "PATH",          // for commands
+        "XDG_DATA_DIRS", // for loadable completion
+    };
+
+    std::ostringstream out;
+
+    out << "unset shellHook\n";
+
+    for (auto & var : savedVars) {
+        out << fmt("%s=${%s:-}\n", var, var);
+        out << fmt("nix_saved_%s=\"$%s\"\n", var, var);
+    }
+
+    toBash(out, interactiveIgnoreVars);
+
+    for (auto & var : savedVars)
+        out << fmt("%s=\"$%s${nix_saved_%s:+:$nix_saved_%s}\"\n", var, var, var, var);
+
+    out << "export NIX_BUILD_TOP=\"$(mktemp -d -t nix-shell.XXXXXX)\"\n";
+    for (auto & i : {"TMP", "TMPDIR", "TEMP", "TEMPDIR"})
+        out << fmt("export %s=\"$NIX_BUILD_TOP\"\n", i);
+
+    out << "eval \"${shellHook:-}\"\n";
+
+    auto script = out.str();
+
+    /* Substitute occurrences of output paths. */
+    auto outputs = vars.find("outputs");
+    if (outputs == vars.end())
+        throw Error("derivation does not have an 'outputs' attribute");
+
+    StringMap rewrites;
+    if (providesStructuredAttrs()) {
+        for (auto & [outputName, from] : getAssociative(outputs->second)) {
+            rewrites.insert({from, (outputsDir / outputName).string()});
+        }
+    } else {
+        for (auto & outputName : getStrings(outputs->second)) {
+            auto from = vars.find(outputName);
+            assert(from != vars.end());
+            rewrites.insert({
+                getString(from->second),
+                (outputsDir / outputName).string(),
+            });
+        }
+    }
+
+    rewrites.insert(extraRewrites.begin(), extraRewrites.end());
+
+    if (providesStructuredAttrs()) {
+        fixupStructuredAttrs(OS_STR("sh"), "NIX_ATTRS_SH_FILE", getAttrsSH(), rewrites, *this, tmpDir);
+        fixupStructuredAttrs(OS_STR("json"), "NIX_ATTRS_JSON_FILE", getAttrsJSON(), rewrites, *this, tmpDir);
+    }
+
+    return rewriteStrings(script, rewrites);
+}
+
 } // namespace nix
