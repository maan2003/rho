From: maan2003 <manmeetmann2003@gmail.com>
Date: Wed, 23 Sep 2026 16:28:31 +0000
Subject: [PATCH 1/2] libexpr: report input mounts and forced source-info
 metadata as eval effects

---
 src/libexpr-tests/lazy-fetcher-attr.cc |  23 +++++
 src/libexpr/eval-effect.hh             |  12 ++-
 src/libexpr/paths.cc                   |   3 +
 src/libexpr/primops/fetchTree.cc       | 113 ++++++++++++++++++++++---
 4 files changed, 138 insertions(+), 13 deletions(-)

diff --git a/src/libexpr-tests/lazy-fetcher-attr.cc b/src/libexpr-tests/lazy-fetcher-attr.cc
index 4c36424ec..f52fe6e63 100644
--- a/src/libexpr-tests/lazy-fetcher-attr.cc
+++ b/src/libexpr-tests/lazy-fetcher-attr.cc
@@ -97,4 +97,27 @@ TEST_F(LazyFetcherAttrTest, lazyFunctionOnlyCalledOnAccess)
     EXPECT_EQ(calls, 1);
 }
 
+TEST_F(LazyFetcherAttrTest, observedAttrsForceToTheirValues)
+{
+    fetchers::Input input;
+    input.attrs.insert_or_assign("type", std::string("git"));
+    input.attrs.insert_or_assign("rev", std::string("0123456789abcdef0123456789abcdef01234567"));
+    input.attrs.insert_or_assign("lastModified", uint64_t(0));
+
+    Value v;
+    emitTreeAttrs(state, dummyPath(), input, v, false, false);
+    state.forceValue(v, noPos);
+
+    auto * revAttr = v.attrs()->get(state.symbols.create("rev"));
+    ASSERT_NE(revAttr, nullptr);
+    EXPECT_EQ(revAttr->value->type(), nThunk);
+    state.forceValue(*revAttr->value, noPos);
+    EXPECT_EQ(revAttr->value->string_view(), "0123456789abcdef0123456789abcdef01234567");
+
+    auto * dateAttr = v.attrs()->get(state.symbols.create("lastModifiedDate"));
+    ASSERT_NE(dateAttr, nullptr);
+    state.forceValue(*dateAttr->value, noPos);
+    EXPECT_EQ(dateAttr->value->string_view(), "19700101000000");
+}
+
 } // namespace nix
