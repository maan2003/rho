     storeFS->mount(CanonPath(store->printStorePath(storePath)), accessor);
 
+    evalEffect(EvalEffect::MountInput, store->printStorePath(storePath), originalInput.to_string());
+
     input.attrs.insert_or_assign("narHash", narHash.to_string(HashFormat::SRI, true));
 
     if (originalInput.getNarHash() && narHash != *originalInput.getNarHash())
diff --git a/src/libexpr/primops/fetchTree.cc b/src/libexpr/primops/fetchTree.cc
index 0e092927b..86457e786 100644
--- a/src/libexpr/primops/fetchTree.cc
+++ b/src/libexpr/primops/fetchTree.cc
@@ -14,6 +14,8 @@
 #include "nix/fetchers/fetch-to-store.hh"
 #include "nix/fetchers/input-cache.hh"
 
+#include "../eval-effect.hh"
+
 #include <nlohmann/json.hpp>
 
 #include <ctime>
@@ -116,6 +118,94 @@ static void emitLazyAttrThunk(EvalState & state, const fetchers::LazyAttr & lazy
     dest.mkApp(vPrimOp, vExt);
 }
 
+/**
+ * Adapter carrying a source-info metadata attribute whose observation should
+ * be reported as an `input-attr` eval effect when forced.
+ */
+class ObservedInputAttr : public ExternalValueBase, public gc_cleanup
+{
+private:
+    /* VTable anchor, see LazyFetcherAttr. */
+    virtual void anchor();
+
+public:
+    std::string storePath;
+    std::string name;
+    Value * inner;
+
+    ObservedInputAttr(std::string storePath, std::string name, Value * inner)
+        : storePath(std::move(storePath))
+        , name(std::move(name))
+        , inner(inner)
+    {
+    }
+
+protected:
+    std::ostream & print(std::ostream & str) const override
+    {
+        unreachable();
+    }
+
+public:
+    std::string showType() const override
+    {
+        unreachable();
+    }
+
+    std::string typeOf() const override
+    {
+        unreachable();
+    }
+};
+
+void ObservedInputAttr::anchor() {}
+
+/**
+ * internal primop: Report and force an ObservedInputAttr external value.
+ */
+static void prim_forceObservedInputAttr(EvalState & state, const PosIdx pos, Value ** args, Value & v)
+{
+    Value & arg = *args[0];
+
+    state.forceValue(arg, pos);
+    assert(arg.type() == nExternal);
+    auto * ext = dynamic_cast<ObservedInputAttr *>(args[0]->external());
+    assert(ext);
+
+    evalEffect(EvalEffect::InputAttr, ext->storePath, ext->name);
+    state.forceValue(*ext->inner, pos);
+    v = *ext->inner;
+}
+
+/**
+ * Allocate `name` in `attrs` as a thunk that reports an `input-attr` effect
+ * when forced, and return the value the caller should initialize instead.
+ * This lets eval caches treat metadata such as `self.rev` as an input only
+ * when the evaluation actually depends on it.
+ */
+static Value & observedInputAttr(
+    EvalState & state, BindingsBuilder & attrs, const StorePath & storePath, std::string_view name)
+{
+    // not user-callable (unregistered, internal)
+    static PrimOp forcePrimOp{
+        .name = "__forceObservedInputAttr",
+        .arity = 1,
+        .impl = prim_forceObservedInputAttr,
+        .internal = true,
+    };
+
+    auto * inner = state.allocValue();
+
+    auto * vExt = state.allocValue();
+    vExt->mkExternal(new ObservedInputAttr(state.store->printStorePath(storePath), std::string(name), inner));
+
+    auto * vPrimOp = state.allocValue();
+    vPrimOp->mkPrimOp(&forcePrimOp);
+
+    attrs.alloc(name).mkApp(vPrimOp, vExt);
+    return *inner;
+}
+
 void emitTreeAttrs(
     EvalState & state,
     const StorePath & storePath,
@@ -125,6 +215,7 @@ void emitTreeAttrs(
     bool forceDirty)
 {
     auto attrs = state.buildBindings(100);
+    auto observed = [&](std::string_view name) -> Value & { return observedInputAttr(state, attrs, storePath, name); };
 
     state.mkStorePathString(storePath, attrs.alloc(state.s.outPath));
 
@@ -139,31 +230,31 @@ void emitTreeAttrs(
     if (!forceDirty) {
 
         if (auto rev = input.getRev()) {
-            attrs.alloc("rev").mkString(rev->gitRev(), state.mem);
-            attrs.alloc("shortRev").mkString(rev->gitShortRev(), state.mem);
+            observed("rev").mkString(rev->gitRev(), state.mem);
+            observed("shortRev").mkString(rev->gitShortRev(), state.mem);
         } else if (emptyRevFallback) {
             // Backwards compat for `builtins.fetchGit`: dirty repos return an empty sha1 as rev
             auto emptyHash = Hash(HashAlgorithm::SHA1);
-            attrs.alloc("rev").mkString(emptyHash.gitRev(), state.mem);
-            attrs.alloc("shortRev").mkString(emptyHash.gitShortRev(), state.mem);
+            observed("rev").mkString(emptyHash.gitRev(), state.mem);
+            observed("shortRev").mkString(emptyHash.gitShortRev(), state.mem);
         }
 
         if (auto revCount = maybeGetLazyAttr(input.attrs, "revCount"))
-            emitLazyAttrThunk(state, *revCount, attrs.alloc("revCount"));
+            emitLazyAttrThunk(state, *revCount, observed("revCount"));
         else if (auto revCount = input.getRevCount())
-            attrs.alloc("revCount").mkInt(*revCount);
+            observed("revCount").mkInt(*revCount);
         else if (emptyRevFallback)
-            attrs.alloc("revCount").mkInt(0);
+            observed("revCount").mkInt(0);
     }
 
     if (auto dirtyRev = fetchers::maybeGetStrAttr(input.attrs, "dirtyRev")) {
-        attrs.alloc("dirtyRev").mkString(*dirtyRev, state.mem);
-        attrs.alloc("dirtyShortRev").mkString(*fetchers::maybeGetStrAttr(input.attrs, "dirtyShortRev"), state.mem);
+        observed("dirtyRev").mkString(*dirtyRev, state.mem);
+        observed("dirtyShortRev").mkString(*fetchers::maybeGetStrAttr(input.attrs, "dirtyShortRev"), state.mem);
     }
 
     if (auto lastModified = input.getLastModified()) {
-        attrs.alloc("lastModified").mkInt(*lastModified);
-        attrs.alloc("lastModifiedDate")
+        observed("lastModified").mkInt(*lastModified);
+        observed("lastModifiedDate")
             .mkString(fmt("%s", std::put_time(std::gmtime(&*lastModified), "%Y%m%d%H%M%S")), state.mem);
     }
 
