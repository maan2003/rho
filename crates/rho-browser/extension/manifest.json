{
  "manifest_version": 3,
  "name": "Rho Browser Pages",
  "version": "1.4.5",
  "description": "Rho's bundled page registry and per-document Vim agent.",
  "key": "",
  "permissions": ["clipboardWrite", "nativeMessaging", "storage", "tabs"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content-script.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }]
}
