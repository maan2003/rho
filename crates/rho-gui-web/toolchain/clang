#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/../../.." && pwd)"
includes=()
case "$PWD" in
  *tree-sitter*) includes=(-I"$root/vendor/zed/tooling/tree_sitter_wasm/include") ;;
esac
exec /nix/store/482i7k840pk0cmv6qhf4rf5gyah1lq8l-clang-21.1.8/bin/clang \
  "${includes[@]}" "$@"
